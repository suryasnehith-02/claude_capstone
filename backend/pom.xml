<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot 4.1.3 and sqlite-jdbc 3.54.1.0 are human-supplied versions (clarifications S5-4, S5-6).
       The dependencies resolve and the project builds and tests with Boot 4.1.3 (Maven wrapper, JDK 25). -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.3</version>
    <relativePath/>
  </parent>

  <groupId>com.capstone</groupId>
  <artifactId>todo-backend</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>todo-backend</name>
  <description>Todo App backend: task management REST APIs (CAP-2)</description>

  <properties>
    <java.version>21</java.version>
    <!-- Explicit so that the compiler release 21 does not depend on the parent mapping java.version
         to the compiler release (V-30). Build and tests run on the installed JDK 25. -->
    <maven.compiler.release>21</maven.compiler.release>
    <sqlite-jdbc.version>3.54.1.0</sqlite-jdbc.version>
    <!-- Surefire excludes this tag by default. The performance profile replaces it with a tag
         name no test uses, so nothing is excluded (an empty value is not relied on). -->
    <todo.excluded.groups>performance</todo.excluded.groups>
    <todo.native.access>--enable-native-access=ALL-UNNAMED</todo.native.access>
  </properties>

  <dependencies>
    <!-- All artifacts below resolve with Boot 4.1.3. The web starter is deprecated there in favour of
         spring-boot-starter-webmvc (still resolves; kept for now). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- The version is pinned explicitly here (property sqlite-jdbc.version); it resolves and loads. -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite-jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- spring-boot:run JVM argument (architecture 10.2). Never run: spring-boot:run has not been
               executed with this parameter, so it is the one item in this file not exercised by a build. -->
          <jvmArguments>${todo.native.access}</jvmArguments>
        </configuration>
      </plugin>

      <!-- Unit, repository and contract tests. Plugin versions come from the Boot parent; Surefire runs with this configuration. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>${todo.native.access}</argLine>
          <excludedGroups>${todo.excluded.groups}</excludedGroups>
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- Forced-kill durability test (T-14, DR-21, V-28): runs *IT classes after package. Observed in
           run t14-03: the Boot parent already binds the integration-test and verify goals ("default"
           executions) and this plugin-level configuration applies to them, so no explicit executions
           are declared here (explicit ones ran a second time and were skipped by Maven). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <argLine>${todo.native.access}</argLine>
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <!-- Keep the test class path on target/classes, not on the repackaged Boot JAR. -->
          <classesDirectory>${project.build.outputDirectory}</classesDirectory>
          <systemPropertyVariables>
            <!-- Path of the packaged JAR the child JVM starts (the Boot plugin replaces the main
                 artifact in the package phase, which runs before integration-test). -->
            <todo.packaged-jar>${project.build.directory}/${project.build.finalName}.jar</todo.packaged-jar>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- ./mvnw -B verify -Pperformance : runs the suite without excluding the tag "performance". -->
    <profile>
      <id>performance</id>
      <properties>
        <todo.excluded.groups>none-excluded</todo.excluded.groups>
      </properties>
    </profile>
  </profiles>
</project>
